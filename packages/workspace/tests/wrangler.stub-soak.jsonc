{
  // Test-only worker for the WorkspaceStub disposal soak. Not deployed.
  //
  // Exposes a single DO (WsdContainer) that holds a Workspace backed
  // by an in-process fake backend, plus a TestDriver WorkerEntrypoint
  // that the vitest harness reaches via SELF / cloudflareTest exports.
  "name": "workspace-stub-soak",
  "main": "./stub-soak-worker.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CAPNWEB_TRACK_STUBS": "1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WSD",
        "class_name": "WsdContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WsdContainer"]
    }
  ]
}
