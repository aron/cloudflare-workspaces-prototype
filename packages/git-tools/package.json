{
  "name": "@cloudflare/git-tools",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-SDK tools that drive isomorphic-git against @cloudflare/workspace-backed filesystems. Currently exposes gitClone only.",
  "exports": {
    ".": { "import": "./src/index.ts", "types": "./src/index.ts" }
  },
  "files": ["src/", "README.md"],
