    "test:watch":"vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod":                 "^4.4.3"
  },
  "peerDependencies": {
    "ai":                    "^6.0.0",
    "@cloudflare/workspace": "^0.0.0-alpha.6"
  },
  "devDependencies": {
    "@cloudflare/workspace":     "0.0.0-alpha.6",
    "@cloudflare/workers-types": "^4.20260606.1",
    "@types/node":               "^22.0.0",
    "ai":                        "^6.0.188",
    "typescript":                "^5.7.0",
    "vitest":                    "^4.1.0"
  }
}
