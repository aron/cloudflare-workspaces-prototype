{
  "name": "@cloudflare/workspace-rpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/cjs/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/cjs/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/cjs/client.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workspace-fs": "*",
    "capnweb": "^0.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250529.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
