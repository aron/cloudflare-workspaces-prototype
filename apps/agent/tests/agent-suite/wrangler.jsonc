{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "agent-tests",
  "compatibility_date": "2026-06-06",
  "compatibility_flags": [
    "nodejs_compat",
    // vitest-pool-workers loads SSR-transformed modules via require(), and
    // the wrapper bodies contain `await __vite_ssr_import__(...)` calls
    // (top-level await inside require). The `disable_top_level_await_in_require`
    // flag is on by default for any compat date >= 2024-12-02, which makes
    // workerd reject those modules with an opaque
    // `SyntaxError: Invalid or unexpected token`. Re-enable the legacy
    // behaviour explicitly so the test suite can load the agent.
    "enable_top_level_await_in_require",
    "enable_nodejs_tty_module",
    "enable_nodejs_fs_module",
    "enable_nodejs_http_modules",
    "enable_nodejs_perf_hooks_module",
    "enable_nodejs_v8_module",
    "enable_nodejs_process_v2"
  ],
  // No AI binding — tests never trigger model turns.
  // No Sandbox container binding — tests never exercise exec/run.
  "durable_objects": {
    "bindings": [
      { "class_name": "Agent",      "name": "Agent" },
      { "class_name": "SubAgent",   "name": "SubAgent" }
    ]
  },
  "r2_buckets": [
    { "binding": "SKILLS", "bucket_name": "hackspace-skills-test" }
  ],
  "main": "_worker.ts",
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Agent", "SubAgent"]
    }
  ],
  // Pin vars so dev secrets in .dev.vars can't leak into tests — vitest-pool-workers
  // otherwise inherits the dev env. BRAVE_API_KEY is a dummy so the websearch tool
  // registers under getTools() (tests inspect tool-name visibility, no network).
  // OpenAI key is force-cleared so the Workers AI fallback model is selected.
  "vars": {
    "BRAVE_API_KEY":  "test-key",
    "OPENAI_API_KEY": "",
    "OPENAI_MODEL":   ""
  }
}
