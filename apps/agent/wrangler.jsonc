{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackspace-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  // `enable_abortsignal_rpc` is experimental but required: alpha.9's
  // CloudflareContainerBackend health probe (`probeWsdHealth`) passes
  // an AbortSignal into `host.fetchPort(...)`, and our cross-DO
  // topology means that call crosses Workers RPC. Without the flag
  // workerd rejects the call with "AbortSignal serialization is not
  // enabled." and the backend never reaches readiness. See
  // https://github.com/cloudflare/workerd compatibility-date.capnp
  // (abortSignalRpc, flag enable_abortsignal_rpc).
  "compatibility_flags": ["nodejs_compat", "enable_abortsignal_rpc"],

  "ai": { "binding": "AI", "remote": true },
  "r2_buckets": [
    { "binding": "SKILLS", "bucket_name": "hackspace-skills" },
    // Bucket the agent's `assets publish` command uploads to. Each
    // upload mints a fresh randomised key under a session prefix so
    // re-shares of the same file don't collide. The presigner needs
    // R2 S3 credentials in addition to the binding (the binding alone
    // can't mint a presigned GET URL) — see the R2_* vars below.
    // Without those credentials the Agent skips wiring the assets
    // client and the shell-backend `assets publish` command reports
    // "publishing is not configured for this workspace" rather than
    // surfacing an RPC error.
    { "binding": "ASSETS", "bucket_name": "hackspace-assets" }
  ],
  "kv_namespaces": [
    {
      "binding": "MCP_TOKENS",
      "id": "d9698912689e45969c74e56182536d68"
    }
  ],
  // Cloudflare Artifacts binding. The workspace wires this into the
  // worker-backend shell as an `artifact` custom command, enabling
  // `exec({ command: 'artifact create <name>' })` and
  // `exec({ command: 'artifact share <name>' })` without reaching
  // the public network. Remove or comment out if the account does
  // not have the Artifacts beta.
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "hackspace-prototype"
    }
  ],

  // Worker Loader binding. The Agent DO's Workspace mounts a worker
  // backend (just-bash in a Dynamic Worker) alongside the container
  // backend so cheap textual commands skip the container roundtrip;
  // the worker backend dials through env.LOADER. Private-beta binding
  // — the deploy account needs the worker-loader feature flag.
  "worker_loaders": [{ "binding": "LOADER" }],

  // Per-user Cloudflare MCP OAuth tokens. Keyed by user id so a user
  // authorizes their Cloudflare account once and every thread (Agent DO)
  // reuses it. Replace the placeholder id before deploy:
  //   npx wrangler kv namespace create MCP_TOKENS
  "kv_namespaces": [
    { "binding": "MCP_TOKENS", "id": "REPLACE_WITH_MCP_TOKENS_KV_ID" }
  ],

  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*", "/debug/*", "/personas"]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-2",
      "max_instances": 100
    }
  ],

  "durable_objects": {
    "bindings": [
      { "class_name": "Agent", "name": "Agent" },
      { "class_name": "SubAgent", "name": "SubAgent" },
      { "class_name": "App", "name": "App" },
      { "class_name": "Room", "name": "Room" },
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "WarmPool", "name": "WarmPool" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Agent", "Sandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["WarmPool"] },
    { "tag": "v3", "new_sqlite_classes": ["SubAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["App", "Room"] }
  ],

  // Cron trigger — primes the warm pool so its alarm loop starts on deploy.
  // Runs every minute. Remove if you only want manual priming.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "SANDBOX_TRANSPORT": "rpc",

    // Number of pre-warmed sandbox containers to keep ready.
    "WARM_POOL_TARGET": "3",
    "WARM_POOL_REFRESH_INTERVAL": "10000",

    "OPENAI_MODEL": "gpt-5.5"

    // R2 S3 credentials for the `assets publish` shell command. The
    // R2 binding alone can't mint a presigned GET URL; the assets
    // client (createAssets in src/agent.ts) needs the access
    // key/secret to sign URLs against the R2 S3 endpoint, and the
    // account id (or an explicit endpoint) to know which endpoint
    // to sign against.
    //
    // Set R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY as secrets
    // (`wrangler secret put ...`), not vars — they're sensitive.
    // The placeholders here exist so a fresh checkout's wrangler
    // dev sees the names declared; the empty strings are equivalent
    // to leaving them unset, and the Agent gates the assets client
    // on both creds being non-empty.
    // "R2_ACCESS_KEY_ID": "",
    // "R2_SECRET_ACCESS_KEY": "",
    // "CLOUDFLARE_ACCOUNT_ID": "",
    // "R2_ENDPOINT": ""

    // Public origin used to build absolute URLs in agent messages and
    // Google Chat notifications. Leave unset to fall back to the origin of
    // the inbound request (forwarded as `x-app-base-url` from the worker).
    // "APP_BASE_URL": "https://hackspace-prototype.example.workers.dev"

    // Cloudflare Access JWT gate. Uncomment + fill in to enable; leave
    // unset for an unauthenticated deploy or local dev.
    // "ACCESS_TEAM_DOMAIN": "yourteam.cloudflareaccess.com",
    // "ACCESS_AUD":         "<aud-tag-from-access-app-settings>"
  },
  "observability": {
    "enabled": true,
    // Enable the `cloudflare:workers` tracing binding (private beta).
    // The agent emits spans via `src/tracing.ts` and the workspace
    // package; `persist: true` (default) sends them to the dashboard's
    // observability platform. No sampling rate set — collect everything
    // until volume forces a sampler.
    "traces": {
      "enabled": true
    }
  },
  "workers_dev": true,
  "preview_urls": false
}
