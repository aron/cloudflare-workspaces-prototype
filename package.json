{
  "name": "cloudflare-workspaces-prototype",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:bin": "npm run build:bin --workspaces --if-present",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.10.7",
    "@yao-pkg/pkg": "^6.20.0",
    "typescript": "^6.0.3"
  },
  "pkg": {
    "assets": [
      "node_modules/fuse-native/prebuilds/**/*",
      "node_modules/fuse-shared-library-darwin/**/*",
      "node_modules/fuse-shared-library-linux/**/*",
      "node_modules/fuse-shared-library-linux-arm/**/*",
      "node_modules/@platformatic/vfs/**/*",
      "packages/workspace-fs/dist/**/*",
      "packages/workspace-rpc/dist/**/*"
    ]
  }
}
