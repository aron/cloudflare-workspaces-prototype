{
  // Example: Worker + Durable Object hosting a Cloudflare Container whose
  // ENTRYPOINT is the wsd daemon. This scaffold proves the wiring — the
  // Worker reaches the DO, the DO boots the container, the container's
  // wsd process answers /health on port 8080.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wsd-container-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": ["nodejs_compat"],

  "containers": [
    {
      "class_name": "WsdContainer",
      // Built from the local Dockerfile, which bakes in the wsd binary
      // produced by `npm run build:bin --workspace @cloudflare/workspace-wsd`.
      "image": "./Dockerfile",
      "max_instances": 5
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "WSD",
        "class_name": "WsdContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WsdContainer"]
    }
  ]
}
